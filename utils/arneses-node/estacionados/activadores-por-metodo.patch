+            "if (!ctx.isNil) { vm.", freeList, " = ctx.pointers[0]; vm.nRecycledContexts++; }\n",
+            "else { vm.nAllocatedContexts++; ctx = vm.instantiateClass(vm.specialObjects[", Squeak.splOb_ClassMethodContext, "], ", frameSize, "); }\n",
+            "var p = ctx.pointers, stack = vm.stack, sp = vm.sp;\n",
+            "p[", Squeak.Context_method, "] = method;\n",
+            "p[", Squeak.BlockContext_initialIP, "] = vm.nilObj;\n",
+            "p[", Squeak.Context_sender, "] = vm.activeContext;\n");
