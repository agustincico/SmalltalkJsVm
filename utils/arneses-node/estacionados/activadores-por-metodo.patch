+            "vm.activeContext = ctx; ctx.dirty = true;\n",
+            "vm.homeContext = ctx;\n",
+            "vm.method = method;\n",
+            "vm.pc = 0;\n",
+            "vm.sp = ", TFS + T - 1, ";\n",
+            "vm.stack = p;\n",
+            "vm.temps = p;\n",
+            "vm.tempOffset = ", TFS, ";\n",
+            "vm.receiver = p[", Squeak.Context_receiver, "];\n",
